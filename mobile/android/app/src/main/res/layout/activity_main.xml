<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/permissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/adb_hint" />

        <TextView
            android:id="@+id/adbCommand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:textIsSelectable="true" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/watchSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/watch_switch" />

        <Button
            android:id="@+id/testApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/test_app" />

        <Button
            android:id="@+id/testAnr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_anr" />

        <Button
            android:id="@+id/testSystem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_system" />
    </LinearLayout>
</ScrollView>
